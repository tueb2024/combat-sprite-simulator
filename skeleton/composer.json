{
    "name": "jumphp-games/skeleton",
    "description": "A JumPHP game",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "jumphp/engine": "@dev"
    },
    "repositories": [
        { "type": "path", "url": "../../engine" },
        { "type": "vcs", "url": "https://git.jumphp.net/jumphp/php-wasm-network" }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": { "App\\": "src/" }
    },
    "config": {
        "sort-packages": true,
        "platform-check": false
    }
}
